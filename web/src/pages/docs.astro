---
import { Marked } from "marked";
import { markedHighlight } from "marked-highlight";
import hljs from "highlight.js/lib/core";
import bash from "highlight.js/lib/languages/bash";
import rust from "highlight.js/lib/languages/rust";
import "highlight.js/styles/github-dark.css";
import BaseLayout from "../layouts/BaseLayout.astro";

hljs.registerLanguage("bash", bash);
hljs.registerLanguage("rust", rust);

interface TocEntry {
    text: string;
    level: number;
    id: string;
}

const res = await fetch(
    "https://raw.githubusercontent.com/ujjwalvivek/devhub-gpui/main/ADR.md",
);
const raw = await res.text();

const toc: TocEntry[] = [];
const usedIds = new Map<string, number>();

function slug(text: string): string {
    var s = text
        .toLowerCase()
        .replace(/<[^>]+>/g, "")
        .replace(/&[a-z]+;/g, "")
        .replace(/[^\w]+/g, "-")
        .replace(/^-|-$/g, "");
    if (usedIds.has(s)) {
        var n = usedIds.get(s)! + 1;
        usedIds.set(s, n);
        s = s + "-" + n;
    } else {
        usedIds.set(s, 0);
    }
    return s;
}

const marked = new Marked(
    markedHighlight({
        langPrefix: "hljs language-",
        highlight(code: string, lang: string) {
            const language = hljs.getLanguage(lang) ? lang : "plaintext";
            if (language === "plaintext") return code;
            return hljs.highlight(code, { language }).value;
        },
    }),
);

const renderer = {
    heading({ tokens, depth }: { tokens: any[]; depth: number }) {
        const text = this.parser.parseInline(tokens);
        const id = slug(text);
        if (depth <= 4) {
            toc.push({ text, level: depth, id });
        }
        return `<h${depth} id="${id}">${text}</h${depth}>\n`;
    },
    code({ text, lang }: { text: string; lang?: string }) {
        const langClass = lang ? `hljs language-${lang}` : "hljs";
        return `<div class="code-block-wrap"><button class="copy-btn" onclick="copyCode(this)" aria-label="Copy code"><svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M2 2h13v5.5h-2V4H4v9h3.5v2H2zm7 7h13v13H9z" /></svg></button><pre><code class="${langClass}">${text}</code></pre></div>`;
    },
};

marked.use({ renderer });

const html = await marked.parse(raw);

interface TreeNode {
    entry: TocEntry | null;
    children: TreeNode[];
}
var root: TreeNode = { entry: null, children: [] };
var stk: TreeNode[] = [root];

for (var _j = 0; _j < toc.length; _j++) {
    var e = toc[_j];
    var node: TreeNode = { entry: e, children: [] };
    while (stk.length > 1 && stk[stk.length - 1].entry!.level >= e.level) {
        stk.pop();
    }
    stk[stk.length - 1].children.push(node);
    stk.push(node);
}

function renderTree(node: TreeNode): string {
    if (node.children.length === 0) return "";
    var items: string[] = [];
    for (var k = 0; k < node.children.length; k++) {
        var child = node.children[k];
        var inner = renderTree(child);
        items.push(
            "<li>" +
                '<a href="#' +
                child.entry!.id +
                '">' +
                child.entry!.text +
                "</a>" +
                inner +
                "</li>",
        );
    }
    return "<ul>" + items.join("") + "</ul>";
}

var tocHtml = renderTree(root);
---

<BaseLayout
    title="LLM Rationale"
    description="Decision log and technical rationale for porting DevHub from egui to GPUI"
    showWallpaperBtn={false}
>
    <script is:inline>
        (function () {
            function updateBadgeThemes() {
                var s = getComputedStyle(document.documentElement);
                var read = function (n) {
                    return s.getPropertyValue(n).trim().replace("#", "");
                };
                var bg = read("--bg-card");
                var border = read("--border");
                var text = read("--text");
                var imgs = document.querySelectorAll(
                    'img[src*="echopoint.ujjwalvivek.com/svg/badges/"]',
                );
                for (var i = 0; i < imgs.length; i++) {
                    var src = imgs[i].getAttribute("src");
                    if (!src) continue;
                    src = src.replace(/bg=[^&]+/, "bg=" + bg);
                    src = src.replace(
                        /badgeColor=[^&]+/,
                        "badgeColor=" + border,
                    );
                    src = src.replace(/textColor=[^&]+/, "textColor=" + text);
                    src = src.replace(/\bborder=[^&]+/, "border=" + border);
                    imgs[i].setAttribute("src", src);
                }
            }
            var ready = function () {
                updateBadgeThemes();
                var observer = new MutationObserver(updateBadgeThemes);
                observer.observe(document.documentElement, {
                    attributes: true,
                    attributeFilter: ["data-theme", "data-mode"],
                });
            };
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", ready);
            } else {
                ready();
            }
        })();
    </script>

    <script is:inline>
        function copyCode(btn) {
            var code = btn.parentElement.querySelector("code");
            var text = code.textContent;
            navigator.clipboard.writeText(text).then(function () {
                btn.innerHTML =
                    '<svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="m9 20.42l-6.21-6.21l2.83-2.83L9 14.77l9.88-9.89l2.83 2.83z" /></svg>';
                setTimeout(function () {
                    btn.innerHTML =
                        '<svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M2 2h13v5.5h-2V4H4v9h3.5v2H2zm7 7h13v13H9z" /></svg>';
                }, 2000);
            });
        }
    </script>

    <script is:inline>
        (function () {
            function initTocScroll() {
                var links = document.querySelectorAll('.toc-tree a');
                if (!links.length) return;
                var headings = [];
                links.forEach(function (link) {
                    var id = link.getAttribute('href');
                    if (id && id.startsWith('#')) {
                        var el = document.getElementById(id.slice(1));
                        if (el) headings.push({ el: el, link: link });
                    }
                });
                if (!headings.length) return;
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        var h = headings.find(function (h) { return h.el === entry.target; });
                        if (!h) return;
                        if (entry.isIntersecting) {
                            links.forEach(function (l) { l.classList.remove('toc-active'); });
                            h.link.classList.add('toc-active');
                        }
                    });
                }, { rootMargin: '-80px 0px -70% 0px' });
                headings.forEach(function (h) { observer.observe(h.el); });
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initTocScroll);
            } else {
                initTocScroll();
            }
        })();
    </script>

    <article class="docs">
        <div class="docs-inner">
            <nav class="toc">
                <button
                    class="toc-toggle"
                    onclick="this.parentElement.classList.toggle('open')"
                >
                    <span class="toc-label">Contents</span>
                    <span class="toc-arrow">▶</span>
                </button>
                <div class="toc-tree" set:html={tocHtml} />
            </nav>
            <div class="content" set:html={html} />
        </div>
    </article>
</BaseLayout>

<style>
    .docs {
        padding: 32px 24px 32px;
    }
    .docs-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }
    .toc {
        margin-bottom: 24px;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--bg-card) 15%, transparent);
    }
    .toc-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 800;
        color: var(--text-muted);
    }
    .toc-toggle {
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        background: none;
        border: none;
        cursor: pointer;
        padding: 10px 16px;
        font-family: var(--font-mono);
        color: var(--text-muted);
    }
    .toc-arrow {
        font-size: 14px;
        transition: transform 0.2s;
    }
    .toc.open .toc-arrow {
        transform: rotate(90deg);
    }
    .toc-tree {
        display: none;
        padding: 0 16px 12px;
    }
    .toc.open .toc-tree {
        display: block;
    }

    :global(.toc-tree ul) {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    :global(.toc-tree ul ul) {
        padding-left: 8px;
    }
    :global(.toc-tree li) {
        padding: 3px 0 3px 18px;
        margin: 0;
        position: relative;
    }
    :global(.toc-tree li)::before {
        content: "";
        position: absolute;
        left: 5px;
        top: 14px;
        width: 6px;
        height: 6px;
        background: var(--accent);
    }
    :global(.toc-tree > ul > li) {
        padding-left: 0;
    }
    :global(.toc-tree > ul > li)::before {
        display: none;
    }

    :global(.toc-tree a) {
        font-weight: 400;
        display: inline-block;
        font-size: 13px;
        line-height: 1.5;
        color: var(--text-muted);
        text-decoration: none;
        padding: 2px 6px;
        transition:
            color 0.15s,
            background 0.15s;
    }
    :global(.toc-tree a):hover {
        color: var(--text);
        background: var(--bg-soft);
    }
    :global(.toc-tree a.toc-active) {
        color: var(--accent);
        font-weight: 500;
    }
    .content {
        flex: 1;
        min-width: 0;
        font-size: 15px;
        color: var(--text-dim);
        line-height: 1.6;
        overflow-wrap: break-word;
        word-break: break-word;
    }

    :global(.content h1),
    :global(.content h2),
    :global(.content h3),
    :global(.content h4) {
        font-family: var(--font-mono);
        color: var(--text);
        font-weight: 600;
        letter-spacing: -0.01em;
        text-transform: uppercase;
    }
    :global(.content h1) {
        font-size: 28px;
        margin: 0 0 16px;
    }
    :global(.content h2) {
        font-size: 22px;
        margin: 40px 0 16px;
    }
    :global(.content h3) {
        font-size: 17px;
        margin: 32px 0 12px;
    }
    :global(.content h4) {
        font-size: 14px;
        margin: 24px 0 8px;
    }
    :global(.content p) {
        line-height: 1.6;
        margin: 0 0 16px;
    }
    :global(.content a) {
        color: var(--text);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 1px;
        transition: text-decoration-color 0.15s;
    }
    :global(.content a):hover {
        text-decoration-color: var(--text);
        opacity: 1;
    }
    :global(.content code:not(pre code)) {
        font-family: var(--font-mono);
        font-size: 13px;
        background: var(--bg);
        padding: 2px 6px;
        border: 1px dashed var(--border);
        color: var(--accent);
    }
    :global(.content .code-block-wrap) {
        position: relative;
        margin: 0 0 16px;
    }
    :global(.content .copy-btn) {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 28px;
        height: 28px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        color: var(--text-muted);
        cursor: pointer;
        padding: 0;
        line-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        z-index: 1;
        transition:
            color 0.15s,
            border-color 0.15s;
    }
    :global(.content .copy-btn:hover) {
        color: var(--text);
        border-color: var(--accent);
    }
    :global(.content pre) {
        background: var(--bg-card);
        border: 2px dashed var(--border);
        padding: 16px 20px;
        overflow-x: auto;
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
    }
    :global(.content pre code) {
        background: none;
        border: none;
        padding: 0;
        font-size: 13px;
        line-height: 1.5;
    }
    :global(.content ul) {
        list-style: none;
        padding: 0;
        margin: 0 0 16px;
    }
    :global(.content ul > li) {
        position: relative;
        padding-left: 22px;
        margin-bottom: 6px;
        line-height: 1.6;
    }
    :global(.content ul > li:last-child) {
        margin-bottom: 0;
    }
    :global(.content ul > li)::before {
        content: "";
        position: absolute;
        left: 0;
        top: 10px;
        width: 7px;
        height: 7px;
        background: var(--accent);
        transform: rotate(45deg);
    }

    :global(.content ol) {
        margin: 0 0 16px;
        padding-left: 24px;
    }
    :global(.content ol > li) {
        margin-bottom: 6px;
        padding-left: 4px;
        line-height: 1.6;
    }
    :global(.content li > ul),
    :global(.content li > ol) {
        margin: 6px 0 0;
    }
    :global(.content hr) {
        border: none;
        margin: 16px 0;
    }
    :global(.content blockquote) {
        border-left: 3px solid var(--accent);
        padding: 12px 20px;
        margin: 0 0 16px;
        background: var(--bg-soft);
        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.6;
    }
    :global(.content blockquote p:last-child) {
        margin-bottom: 0;
    }
    :global(.content blockquote p) {
        margin-bottom: 8px;
    }
    :global(.content table) {
        display: block;
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 1.5;
        border-spacing: 0;
        width: 100%;
        border-collapse: collapse;
        border: 1px solid var(--border);
        margin: 0 0 16px;
    }
    :global(.content table :where(thead, tbody, tr, th, td)) {
        font-family: var(--font-mono);
        font-size: inherit;
        line-height: inherit;
    }
    :global(.content thead) {
        background: var(--bg-soft);
    }
    :global(.content th),
    :global(.content td) {
        padding: 4px 12px;
        text-align: left;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }
    :global(.content th) {
        font-weight: 500;
        color: var(--text);
    }
    :global(.content td) {
        color: var(--text-dim);
    }
    :global(.content table :where(th, td):not(:last-child)) {
        border-right: 1px solid var(--border);
    }
    :global(.content tbody tr:last-child td) {
        border-bottom: none;
    }
    :global(.content tbody tr:nth-child(even)) {
        background: var(--bg-soft);
    }
    :global(.content tbody tr):hover {
        background: var(--bg-card);
    }
    :global(.content img) {
        border: none;
        margin: 8px 0;
        vertical-align: middle;
        max-width: 100%;
        height: auto;
    }
    :global(.content strong) {
        color: var(--text);
        font-weight: 600;
    }
    :global(.content h2 + h3) {
        margin-top: 16px;
    }
    @media (max-width: 500px) {
        .docs-inner {
            padding: 0 16px;
        }
    }
</style>
