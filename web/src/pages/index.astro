---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.svelte";
import Features from "../components/Features.svelte";
import Downloads from "../components/Downloads.svelte";
import OpenTelemetry from "../components/OpenTelemetry.svelte";
---

<BaseLayout
    title="DevHub | the only Hub you need"
    description="A local-first native project hub for local and SSH repositories, built in Rust with GPUI."
>
    <Hero client:load />
    <Features client:load />
    <OpenTelemetry client:load />
    <Downloads client:load />
</BaseLayout>
