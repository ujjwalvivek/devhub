{
  "semantic_tokens": "combined",
  "format_on_save": "on",
  "languages": {
    "Rust": {
      "formatter": "language_server",
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "check": {
          "command": "clippy",
          "extraArgs": ["--", "-D", "warnings"],
        },
        "cargo": {
          "buildScripts": {
            "enable": true,
          },
        },
      },
    },
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/target",
    "**/dist",
    "**/build",
    "*.lock",
  ],
}
